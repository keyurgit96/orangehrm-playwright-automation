pipeline {
    agent {
        docker{
            image 'mcr.microsoft.com/playwright/python:v1.40.0-focal'
        }
    }

    parameters {
        string(name: "BROWSER", defaultValue: "chromium", description: "Browser to test")
    }

    environment {
        userID = credentials('UsernamePassword')
    }

    stages {
        stage("Pre-requisites") {
            steps {
                /*sh '''
                    pip install -r requirements.txt
                    playwright install
                    '''*/
            }
        }

        stage('Parallel exce') {
            parallel {
                stage('print1') {
                    steps {
                        sh "pytedst -v -m 'genericTest'"
                    }
                }
                stage('print2') {
                    steps {
                        echo "print2-${params.BROWSER}"
                    }
                }
                stage('credentialsCheck') {
                    steps {
                        // Single quotes ensure environment variables pass directly to Linux shell
                        sh 'echo "Fetched username: '$userID_USR'"'
                        sh 'echo "Fetched password: '$userID_PSW'"'
                    }
                }
            } // End of parallel block
        } // End of Parallel exce stage
    } // End of stages block

    post {
        always {
            echo 'Pipeline completed'
        }
        failure {
            echo 'Pipeline failed'
            emailext(subject: "Pipeline failed",to:'keyurkulkarni96@gmail.com',
                    body:'Pipeline failed')
        }
        success {
            echo 'Pipeline success'
        }
        unstable {
            echo 'Pipeline unstable'
        }
        aborted {
            echo 'Pipeline aborted'
        }
    }
}
