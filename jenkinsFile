pipeline {
    agent {
        docker {
            image 'mcr.microsoft.com/playwright/python:v1.40.0-focal'
        }
    }
    triggers {
        githubPush()
    }
    parameters {
        string(name: "BROWSER", defaultValue: "chromium", description: "Browser to test")
    }

    environment {
        userID = credentials('UsernamePassword')
    }

    stages {
        stage("Pre-requisites") {
            steps {
                sh '''
                    echo "print2-${params.BROWSER}"
                    python3 -m pip install -r src/utils/requirements.txt
                '''
            }
        }

        stage('Parallel exce') {
            parallel {
                stage('print1') {
                    steps {
                        sh '''
                            (apt-get update && apt-get install -y xvfb
                            pip install playwright pytest-playwright
                            playwright install
                            pip install python-dotenv
                            xvfb-run --auto-servernum python3 -m pytest -v -m 'genericTest'
                            '''
                    }
                }
                stage('print2') {
                    steps {
                        echo "print2-${params.BROWSER}"
                    }
                }
                stage('credentialsCheck') {
                    steps {
                        // Use double quotes for the sh block so Groovy safely passes the env variables to bash
                        sh "echo \"Fetched username: ${env.userID_USR}\""
                        sh "echo \"Fetched password: ${env.userID_PSW}\""
                    }
                }
            } // End of parallel block
        } // End of Parallel exce stage
    } // End of stages block

    post {
        always {
            echo 'Pipeline completed'
        }
        failure {
            echo 'Pipeline failed'
            emailext(subject: "Pipeline failed",to:'keyurkulkarni96@gmail.com',
                    body:'Pipeline failed')
        }
        success {
            echo 'Pipeline passed'
            emailext(subject: "Pipeline Passed",to:'keyurkulkarni96@gmail.com',
                    body:'Pipeline Passed')
        }
        unstable {
            echo 'Pipeline unstable'
        }
        aborted {
            echo 'Pipeline aborted'
        }
    }
}
